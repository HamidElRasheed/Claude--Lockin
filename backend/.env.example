# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./lockin.db

# Speech-to-text, primary (ElevenLabs Scribe). Key needs only "Speech to Text" access.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_LANGUAGE=nor

# Speech-to-text, free fallback (Groq Whisper). Optional.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_LANGUAGE=no

DEMO_USER_ID=demo
